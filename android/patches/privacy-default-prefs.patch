@@ -327,14 +327,16 @@ const char Profile::kProfileKey[] = "__PROFILE__";
 
 // static
 void Profile::RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  // Little Browser: no search suggestions (each keystroke would go to the
+  // search engine) and no Touch to Search, by default.
   registry->RegisterBooleanPref(
       prefs::kSearchSuggestEnabled,
-      true,
+      false,
       user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
 #if BUILDFLAG(IS_ANDROID)
   registry->RegisterStringPref(
       prefs::kContextualSearchEnabled,
-      std::string(),
+      "false",
       user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
   registry->RegisterBooleanPref(
       prefs::kContextualSearchWasFullyPrivacyEnabled, false,
