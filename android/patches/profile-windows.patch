@@ -629,8 +629,13 @@ import java.util.function.Supplier;
         }
 
         addOpenUrlInNewWindowIntentExtras(sourceActivity, intent, isIncognitoWindow);
-        if (preferNew) intent.putExtra(IntentHandler.EXTRA_PREFER_NEW, true);
-        else intent.putExtra(IntentHandler.EXTRA_WINDOW_ID, windowId);
+        if (preferNew) {
+            intent.putExtra(IntentHandler.EXTRA_PREFER_NEW, true);
+            // Little Browser: a new window is of the profile of the window it is opened from.
+            app.littlebrowser.lb.profiles.Profiles.carryWindowProfile(sourceActivity, intent);
