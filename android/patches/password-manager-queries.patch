# Little Browser (Android): the browser may see whether the password managers first run offers
# are installed (core/lb-core/src/password_manager.rs; docs/ux.md §12). Android 11 and later hide
# other apps unless the manifest names them.

diff --git a/chrome/android/java/AndroidManifest.xml b/chrome/android/java/AndroidManifest.xml
--- a/chrome/android/java/AndroidManifest.xml
+++ b/chrome/android/java/AndroidManifest.xml
@@ -197,6 +197,13 @@
 
     {% block extra_keyset_definitions %}
     {% endblock %}
+
+    <!-- Little Browser: the password managers first run offers (password_manager.rs). -->
+    <queries>
+      <package android:name="com.onepassword.android" />
+      <package android:name="com.x8bit.bitwarden" />
+      <package android:name="proton.android.pass" />
+    </queries>
 
     {% if channel in ['default'] %}
       <!--
