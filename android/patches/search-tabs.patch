+package org.chromium.chrome.browser.omnibox.suggestions;
+
+import android.content.Context;
+
+import androidx.core.content.ContextCompat;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.omnibox.R;
+import org.chromium.chrome.browser.omnibox.styles.OmniboxDrawableState;
+import org.chromium.chrome.browser.omnibox.styles.OmniboxResourceProvider;
+import org.chromium.chrome.browser.omnibox.styles.SuggestionSpannable;
+import org.chromium.chrome.browser.omnibox.suggestions.base.BaseSuggestionViewProperties;
+import org.chromium.chrome.browser.omnibox.suggestions.basic.SuggestionViewProperties;
+import org.chromium.components.omnibox.GroupsProto.GroupConfig;
+import org.chromium.components.omnibox.suggestions.OmniboxSuggestionUiType;
+import org.chromium.ui.modelutil.PropertyModel;
+
+import app.littlebrowser.lb.search.TabSuggestions;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Little Browser: the search screen's tab rows (app.littlebrowser.lb.search.TabSuggestions, which
+ * the phone shell provides): recent tabs with nothing typed, tabs found by name, title or address
+ * with text. Drawn as basic suggestion rows; tapping one shows its tab and ends the search.
+ */
+@NullMarked
+final class LbTabRowsProcessor implements DropdownItemProcessor {
+    private final Context mContext;
+    private final OmniboxResourceProvider mResources;
+    private final Runnable mFinish;
+
+    LbTabRowsProcessor(Context context, OmniboxResourceProvider resources, Runnable finish) {
+        mContext = context;
+        mResources = resources;
+        mFinish = finish;
+    }
+
+    @Override
+    public int getViewTypeId() {
+        return OmniboxSuggestionUiType.DEFAULT;
+    }
+
+    @Override
+    public int getMinimumViewHeight() {
+        return mContext.getResources()
+                .getDimensionPixelSize(R.dimen.omnibox_suggestion_content_height);
+    }
+
+    @Override
+    public PropertyModel createModel() {
+        // The suggestion views read their sizes from it, as every processor's rows have it.
+        return new PropertyModel.Builder(SuggestionViewProperties.ALL_KEYS)
+                .with(SuggestionCommonProperties.RESOURCE_PROVIDER, mResources)
+                .build();
+    }
+
+    /** The rows for what is typed, ready to go first in the list. */
+    List<DropdownItemViewInfo> rows(String query) {
+        List<DropdownItemViewInfo> rows = new ArrayList<>();
+        for (TabSuggestions.Row row : TabSuggestions.rows(mContext, query)) {
+            PropertyModel model = createModel();
+            model.set(
+                    SuggestionViewProperties.TEXT_LINE_1_TEXT, new SuggestionSpannable(row.title));
+            model.set(
+                    SuggestionViewProperties.TEXT_LINE_2_TEXT,
+                    new SuggestionSpannable(row.subtitle));
+            model.set(SuggestionViewProperties.CONTENT_DESCRIPTION, row.title);
+            var icon = ContextCompat.getDrawable(mContext, R.drawable.ic_globe_24dp);
+            if (icon != null) {
+                model.set(
+                        BaseSuggestionViewProperties.ICON,
+                        new OmniboxDrawableState(
+                                icon,
+                                /* useRoundedCorners= */ false,
+                                /* isLarge= */ false,
+                                /* allowTint= */ true));
+            }
+            model.set(
+                    BaseSuggestionViewProperties.ON_ACTIVATE,
+                    modifiers -> {
+                        mFinish.run();
+                        row.open.run();
+                    });
+            model.set(BaseSuggestionViewProperties.SHOW_DECORATION, true);
+            model.set(BaseSuggestionViewProperties.USE_LARGE_DECORATION, false);
+            model.set(BaseSuggestionViewProperties.TOP_PADDING, 0);
+            rows.add(new DropdownItemViewInfo(this, model, GroupConfig.getDefaultInstance()));
+        }
+        return rows;
+    }
+}
