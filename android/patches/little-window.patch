+    public void addCustomActionButton(
+            Drawable drawable,
+            String description,
+            View.OnClickListener listener,
+            @CustomButtonParams.ButtonType int type) {
+        mModel.get(CustomTabToolbarButtonsProperties.CUSTOM_ACTION_BUTTONS)
