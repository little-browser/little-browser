@@ -137,6 +139,22 @@ public class ChromeLauncherActivity extends Activity {
         // Check if we should push the user through First Run.
         if (FirstRunFlowSequencer.launch(this, intent)) return;
 
+        // Little Browser: a web link from another app opens in a little window. The browser's
+        // own launches don't: its windows' and "open in browser"'s, and a site's home-screen
+        // shortcut, which carries no sender token (ShortcutHelper, WebappLauncherActivity).
+        if (LittleWindow.opensInLittleWindow(
+                intent.getAction(),
+                IntentHandler.getUrlFromIntent(intent),
+                IntentHandler.wasIntentSenderChrome(intent)
+                        || intent.hasExtra(IntentHandler.EXTRA_FROM_OPEN_IN_BROWSER)
+                        || IntentUtils.safeHasExtra(
+                                intent,
+                                org.chromium.chrome.browser.browserservices.intents
+                                        .WebappConstants.REUSE_URL_MATCHING_TAB_ELSE_NEW_TAB),
+                LaunchIntentDispatcher.isCustomTabIntent(intent))) {
+            LittleWindow.markAsLittleWindow(intent);
+        }
+
         // Check if we should launch a Custom Tab.
         if (LaunchIntentDispatcher.isCustomTabIntent(intent)) {
             LaunchIntentDispatcher.dispatchToCustomTabActivity(this, intent);
