+    /**
+     * Little Browser: the built-in ad blocker's per-site switch, under the third-party cookies
+     * switch, where people look when a site doesn't work. SiteAdsSwitch decides what it shows and
+     * does; the switch keeps no value of its own (not persisted), and shows what is stored.
+     */
+    void addAdsSwitch(SiteAdsSwitch adsSwitch) {
+        if (findPreference(ADS_SWITCH_PREFERENCE) != null) return;
+        ChromeSwitchPreference ads = new ChromeSwitchPreference(getContext());
+        ads.setKey(ADS_SWITCH_PREFERENCE);
+        ads.setPersistent(false);
+        ads.setTitle(adsSwitch.title());
+        ads.setSummary(adsSwitch.state());
+        ads.setChecked(adsSwitch.isOn());
+        ads.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    adsSwitch.turn((Boolean) newValue);
+                    ads.setChecked(adsSwitch.isOn());
+                    ads.setSummary(adsSwitch.state());
+                    return false;
+                });
+        getPreferenceScreen().addPreference(ads);
+    }
