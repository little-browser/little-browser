# Little Browser (Android): tablets get the desktop's sidebar layout (docs/ux.md §10, Tablets),
# on Chromium's vertical tabs, which are on by default (vertical-tabs-on.patch is the native
# half). The rail's header shows the shown space and its footer every space
# (app.littlebrowser.lb.shell.SidebarSpaces), laid out with the rail's own buttons each time the
# rail lays those out.

diff --git a/chrome/browser/flags/android/java/src/org/chromium/chrome/browser/flags/ChromeFeatureList.java b/chrome/browser/flags/android/java/src/org/chromium/chrome/browser/flags/ChromeFeatureList.java
--- a/chrome/browser/flags/android/java/src/org/chromium/chrome/browser/flags/ChromeFeatureList.java
+++ b/chrome/browser/flags/android/java/src/org/chromium/chrome/browser/flags/ChromeFeatureList.java
@@ -1019,7 +1019,8 @@
     public static final CachedFlag sAndroidVerticalTabs =
             newCachedFlag(
                     ANDROID_VERTICAL_TABS,
-                    /* defaultValue= */ false,
+                    // Little Browser: tablets get the sidebar layout on vertical tabs.
+                    /* defaultValue= */ true,
                     /* defaultValueInTests= */ true);
     public static final CachedFlag sAndroidWindowManagementWebApi =
             newCachedFlag(
diff --git a/chrome/browser/ui/vertical_tabs/android/java/src/org/chromium/chrome/browser/ui/vertical_tabs/VerticalTabUtils.java b/chrome/browser/ui/vertical_tabs/android/java/src/org/chromium/chrome/browser/ui/vertical_tabs/VerticalTabUtils.java
--- a/chrome/browser/ui/vertical_tabs/android/java/src/org/chromium/chrome/browser/ui/vertical_tabs/VerticalTabUtils.java
+++ b/chrome/browser/ui/vertical_tabs/android/java/src/org/chromium/chrome/browser/ui/vertical_tabs/VerticalTabUtils.java
@@ -158,7 +158,8 @@
      * explicitly set their preference.
      */
     public static boolean isVerticalTabsEnabledByDefault() {
-        return ChromeFeatureList.sAndroidVerticalTabsEnableByDefault.getValue();
+        // Little Browser: on unless turned off in Settings.
+        return true;
     }
 
     /**
diff --git a/chrome/android/features/tab_ui/java/src/org/chromium/chrome/browser/tasks/tab_management/vertical_tabs/VerticalTabRailLayout.java b/chrome/android/features/tab_ui/java/src/org/chromium/chrome/browser/tasks/tab_management/vertical_tabs/VerticalTabRailLayout.java
--- a/chrome/android/features/tab_ui/java/src/org/chromium/chrome/browser/tasks/tab_management/vertical_tabs/VerticalTabRailLayout.java
+++ b/chrome/android/features/tab_ui/java/src/org/chromium/chrome/browser/tasks/tab_management/vertical_tabs/VerticalTabRailLayout.java
@@ -191,6 +191,10 @@
                     }
                 });
         updateHeaderLayout();
+        // Little Browser: the spaces, in the header and the footer.
+        app.littlebrowser.lb.shell.SidebarSpaces.decorate(
+                this, mHeaderContainer, mFooterContainer);
+        updateFooterLayout();
     }
 
     /** Returns the main tab list recycler view. */
@@ -567,6 +571,8 @@
         incognitoParams.setMarginStart(
                 (!isCollapsed && isIncognitoVisible) ? mFooterButtonGapPx : 0);
         mIncognitoButton.setLayoutParams(incognitoParams);
+        // Little Browser: the spaces share the header and footer rows with the rail's buttons.
+        app.littlebrowser.lb.shell.SidebarSpaces.fit(this, mHeaderSpacer, mNewTabButton);
     }
 
