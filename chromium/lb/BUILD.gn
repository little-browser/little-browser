declare_args() {
  # The release's revision, the N of its tag v<Chromium version>-N, which the About page and
  # chrome://version show after the Chromium version (browser/version/release_version.h). 0: not
  # a release. build.sh sets it from LB_RELEASE (write_gn_args in chromium/scripts/lib.sh).
  lb_release_revision = 0
}

# BUILDFLAG(LB_RELEASE_REVISION) for browser/version/release_version.cc, the one file that
# includes it, so a new revision recompiles that file only.
buildflag_header("release_buildflags") {
  header = "release_buildflags.h"
  header_dir = "lb/browser/version"
  flags = [ "LB_RELEASE_REVISION=$lb_release_revision" ]
}

# Engine logic every Chromium platform builds, with no views and no browser window: the ad
