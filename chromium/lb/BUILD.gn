# Unsafe buffer use (raw pointer arithmetic, indexing a C array) is an error in our code on every
# platform. Android's build checks it with Chromium's unsafe-buffers plugin; builds without the
# plugin (the desktop) check our targets' own code with clang's warning, limited to //lb by
# unsafe_buffers_mappings.txt. Clang takes one mappings file, so ours is Chromium's
# (clang_warning_suppression_file, //.gn) with our section added, written when GN runs.
if (is_clang && !clang_use_unsafe_buffers_plugin) {
  _lb_mappings = "$root_gen_dir/lb/warning_suppression.txt"
  _chromium_mappings = ""
  if (clang_warning_suppression_file != "") {
    _chromium_mappings = read_file(clang_warning_suppression_file, "string")
  }
  # Chromium's file ends with a line break.
  write_file(_lb_mappings, _chromium_mappings + read_file("unsafe_buffers_mappings.txt", "string"))
}

config("unsafe_buffers") {
  if (is_clang && !clang_use_unsafe_buffers_plugin) {
    cflags = [
      "-Wunsafe-buffer-usage",
      "-Werror=unsafe-buffer-usage",
      "--warning-suppression-mappings=" + rebase_path(_lb_mappings, root_build_dir),
    ]
    inputs = [ "unsafe_buffers_mappings.txt" ]
    if (clang_warning_suppression_file != "") {
      inputs += [ clang_warning_suppression_file ]
    }
  }
}

# lb-core, the shared Rust core (core/lb-core; fetch.sh links it at //lb_core), built with
# Chromium's toolchain and vendored crates (docs/design.md §4.4). Its tests run as
# lb_core_unittests. Keep `sources` the crate's files (chromium/scripts/check_lb_tests.py checks
# it).
rust_static_library("lb_core") {
  crate_name = "lb_core"
  crate_root = "//lb_core/src/lib.rs"
  edition = "2021"
  sources = [
    "//lb_core/src/adblock.rs",
    "//lb_core/src/command_bar.rs",
    "//lb_core/src/element_hiding.rs",
    "//lb_core/src/import/addresses.rs",
    "//lb_core/src/import/arc.rs",
    "//lb_core/src/import/bookmarks.rs",
    "//lb_core/src/import/bookmarks_html.rs",
    "//lb_core/src/import/cookies.rs",
    "//lb_core/src/import/extensions.rs",
    "//lb_core/src/import/history.rs",
    "//lb_core/src/import/mod.rs",
    "//lb_core/src/import/plan.rs",
    "//lb_core/src/import/profiles.rs",
    "//lb_core/src/import/safari.rs",
    "//lb_core/src/import/search.rs",
    "//lb_core/src/import/sources.rs",
    "//lb_core/src/import/tabs.rs",
    "//lb_core/src/lib.rs",
    "//lb_core/src/model.rs",
    "//lb_core/src/password_manager.rs",
    "//lb_core/src/pinned_groups.rs",
    "//lb_core/src/search_choice.rs",
    "//lb_core/src/spaces.rs",
    "//lb_core/src/sync.rs",
    "//lb_core/src/tabs.rs",
    "//lb_core/src/tracking_params.rs",
  ]
  deps = [ "//third_party/rust/serde_json/v1:lib" ]
  build_native_rust_unit_tests = true
}

# The C++ binding of lb-core (namespace lb::core): include "lb/core_bridge/lib.rs.h" for import,
# "lb/core_bridge/rules.rs.h" for the browser rules (spaces, command bar, filter lists, search
# choice), "lb/core_bridge/tabs.rs.h" for the tab rules (pinned close, tab names and links, pinned
# groups) and the password manager list.
rust_static_library("core_bridge") {
  crate_name = "lb_core_bridge"
  crate_root = "core_bridge/lib.rs"
  edition = "2021"
  allow_unsafe = true  # cxx's generated glue
  sources = [
    "core_bridge/lib.rs",
    "core_bridge/rules.rs",
    "core_bridge/tabs.rs",
  ]
  cxx_bindings = [
    "core_bridge/lib.rs",
    "core_bridge/rules.rs",
    "core_bridge/tabs.rs",
  ]
  deps = [ ":lb_core" ]
}

