# Little Browser: chrome/browser's core target, whose files the shared patches hook (startup,
# the frame binders, the content browser client), depends on our browser-process code every
# Chromium platform runs: the ad blocker's list updates, element hiding's browser side and, through
# it, the engine logic (//lb:browser, chromium/lb/BUILD.gn). //lb:browser depends on Chromium's
# small browser targets (browser_process, profiles, content settings), not on chrome/browser, so
# there is no cycle.
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -1436,6 +1436,10 @@
     "//ui/webui/resources/cr_components/color_change_listener:mojom",
     "//ui/webui/tracked_element",
   ]
+
+  # Little Browser: our browser-process code (chromium/lb/BUILD.gn), which the shared patches'
+  # hooks in this target's files call.
+  deps += [ "//lb:browser" ]
 
   if (enable_webui_ntp) {
     deps += [
