# Little Browser: the built-in ad blocker (docs/design.md section 5). Chromium's subresource
# filter blocks ads and trackers on every site, using the filter lists chromium/lb/browser/adblock
# downloads and hands to its ruleset service.
# - subresource_filter_features.cc: a preset that turns filtering on for all sites, ranked above
#   Chrome's own presets (which only act on sites Safe Browsing lists), without Chrome's console
#   messages for those sites ("this site tends to show ads that interrupt, distract, mislead...").
# - chrome_browser_main.cc: the filter list updater starts with the browser, next to the ruleset
#   service, whatever windows open.
# - profile_interaction_manager.cc: no per-site record of where filtering ran, and no "intrusive
#   ads blocked" notice; ads are allowed per site from the site-info panel's Ads switch, the
#   command bar or Settings.
--- a/components/subresource_filter/core/browser/subresource_filter_features.cc
+++ b/components/subresource_filter/core/browser/subresource_filter_features.cc
@@ -116,6 +116,17 @@
   int result = 0;
   base::StringToInt(value, &result);
   return result;
+}
+
+// Little Browser: block ads on every site, with the filter lists the browser downloads
+// (chromium/lb/browser/adblock). It outranks the presets below, so it decides activation.
+constexpr char kPresetLiveRunOnAllSites[] = "lb_liverun_on_all_sites";
+
+Configuration MakePresetForLiveRunOnAllSites() {
+  Configuration config(mojom::ActivationLevel::kEnabled,
+                       ActivationScope::ALL_SITES);
+  config.activation_conditions.priority = 2000;
+  return config;
 }
 
 std::vector<Configuration> FillEnabledPresetConfigurations(
@@ -127,6 +138,7 @@
     bool enabled_by_default;
     Configuration (*factory_method)();
   } kAvailablePresetConfigurations[] = {
+      {kPresetLiveRunOnAllSites, true, &MakePresetForLiveRunOnAllSites},
       {kPresetLiveRunOnPhishingSites, true,
        &Configuration::MakePresetForLiveRunOnPhishingSites},
       {kPresetPerformanceTestingDryRunOnAllSites, ad_tagging_enabled,
@@ -386,8 +398,11 @@
   // This bit keeps track of BAS enforcement-style logging, not warning logging.
   // TODO(csharrison): Consider removing it since it can be computed directly
   // from the mojom::ActivationLevel.
-  state.enable_logging =
-      effective_activation_level == mojom::ActivationLevel::kEnabled;
+  // Little Browser: not for the all-sites preset. The logging is Chrome's console messages for
+  // sites Safe Browsing lists as showing abusive ads; here every page is filtered.
+  state.enable_logging =
+      effective_activation_level == mojom::ActivationLevel::kEnabled &&
+      activation_conditions.activation_scope != ActivationScope::ALL_SITES;
   return state;
 }
 
