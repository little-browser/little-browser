# Little Browser: a page that loads again when its tab is shown (a sleeping pinned tab, a tab
# restored at startup or by a space switch, a tab discarded in place on Android) checks with the
# server for a newer version instead of showing the cached copy it had (docs/ux.md §6). Chromium
# loads such pages as restores, from the cache without validating it; here a restore validates the
# cache (LOAD_VALIDATE_CACHE, as a reload does), and keeps the page's state as a restore does; its
# subresources load as a reload's do, not from the cache whatever it holds (Blink's kForceCache).
# Offline, the page and its subresources come from the cache as before. A page discarded in place
# comes back as a history load, so LoadIfNecessary marks it restored first; a page sent with POST
# is left alone, so nothing is sent again.
--- a/content/browser/renderer_host/navigation_controller_impl.cc
+++ b/content/browser/renderer_host/navigation_controller_impl.cc
@@ -5105,6 +5105,13 @@
                   ->IsInitialEntryNotForSynchronousAboutBlank()) {
     pending_entry_ = entries_[last_committed_entry_index_].get();
     pending_entry_index_ = last_committed_entry_index_;
+    // Little Browser: a page discarded in place (Android) loads again as a
+    // restore, as one restored into new contents does, so it too asks the
+    // server whether it changed (UpdateLoadFlagsWithCacheFlags). Not one sent
+    // with POST: that would ask to send it again.
+    if (!pending_entry_->GetHasPostData()) {
+      pending_entry_->set_restore_type(RestoreType::kRestored);
+    }
     NavigateToExistingPendingEntry(
         ReloadType::NONE,
         /*initiator_rfh=*/nullptr,
