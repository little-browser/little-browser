 #include "net/base/registry_controlled_domains/registry_controlled_domain.h"
 #include "net/base/url_util.h"
 #include "net/cookies/cookie_access_result.h"
@@ -318,7 +319,13 @@
       *load_flags |= net::LOAD_BYPASS_CACHE;
       break;
     case blink::mojom::NavigationType::RESTORE:
-      *load_flags |= net::LOAD_SKIP_CACHE_VALIDATION;
+      // Little Browser: a page that loads again (a sleeping or restored tab
+      // shown, a space's tabs) asks the server whether it changed, instead of
+      // showing the copy it had then. Its state (scroll, forms) comes back as
+      // before. Offline it is the copy it had, as without this.
+      *load_flags |= net::NetworkChangeNotifier::IsOffline()
+                         ? net::LOAD_SKIP_CACHE_VALIDATION
+                         : net::LOAD_VALIDATE_CACHE;
       break;
     case blink::mojom::NavigationType::RESTORE_WITH_POST:
       *load_flags |=
--- a/third_party/blink/renderer/core/loader/frame_fetch_context.cc
