# Little Browser: register our prefs (chromium/lb/browser/prefs/lb_prefs.h). On every platform:
# Local State's spaces, saved tabs and filter-list download time, each profile's active space and
# first-run questions, and our defaults for Chromium's profile prefs once Chromium has registered
# them (pref_defaults.h). On the desktop also import's Local State and the desktop's own prefs.

--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -62,6 +62,8 @@
 #include "chrome/browser/prefs/chrome_pref_service_factory.h"
 #include "chrome/browser/prefs/incognito_mode_prefs.h"
 #include "chrome/browser/prefs/session_startup_pref.h"
+#include "lb/browser/prefs/lb_prefs.h"
+#include "lb/browser/prefs/pref_defaults.h"
 #include "chrome/browser/preloading/prefetch/prefetch_service/prefetch_origin_decider.h"
 #include "chrome/browser/preloading/prefetch/search_prefetch/search_prefetch_service.h"
 #include "chrome/browser/preloading/preloading_prefs.h"
@@ -1659,6 +1661,11 @@
   // Call outs to individual subsystems that register Local State (browser-wide)
   // prefs en masse. See RegisterProfilePrefs for per-profile prefs. Please
   // keep this list alphabetized.
+  // Little Browser: spaces and the ad blocker on every platform, import on the desktop.
+  lb::RegisterLocalStatePrefs(registry);
+#if !BUILDFLAG(IS_ANDROID)
+  lb::RegisterDesktopLocalStatePrefs(registry);
+#endif
 #if BUILDFLAG(IS_ANDROID)
   accessibility::AccessibilityPrefsController::RegisterLocalStatePrefs(
       registry);
@@ -1990,6 +1997,7 @@
 void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry,
                           const std::string& locale) {
   TRACE_EVENT0("browser", "chrome::RegisterProfilePrefs");
+  lb::RegisterProfilePrefs(registry);  // Little Browser: spaces, first run (every platform)
   // User prefs. Please keep this list alphabetized.
   AccessibilityLabelsService::RegisterProfilePrefs(registry);
   registry->RegisterBooleanPref(prefs::kRendererAccessibilityEnabled, true);
@@ -2448,6 +2456,8 @@
   side_panel_prefs::RegisterProfilePrefs(registry);
 
   tabs::RegisterProfilePrefs(registry);
+  // Little Browser: the desktop's own profile prefs and tab-group defaults.
+  lb::RegisterDesktopProfilePrefs(registry);
 
   CertificateManagerPageHandler::RegisterProfilePrefs(registry);
 
@@ -2531,6 +2541,8 @@
 void RegisterUserProfilePrefs(user_prefs::PrefRegistrySyncable* registry,
                               const std::string& locale) {
   RegisterProfilePrefs(registry, locale);
+  // Little Browser: our defaults for the Chromium prefs registered above (every platform).
+  lb::SetProfilePrefDefaults(registry);
 
 #if BUILDFLAG(IS_ANDROID)
   ::android::RegisterUserProfilePrefs(registry);
--- a/chrome/browser/prefs/BUILD.gn
+++ b/chrome/browser/prefs/BUILD.gn
@@ -59,6 +59,7 @@
   deps = [
     ":prefs",
     ":util",
+    "//lb:prefs",  # Little Browser: our prefs (browser_prefs.cc registers them)
     "//chrome/browser:browser_process",
     "//chrome/browser:browser_process_impl",
     "//chrome/browser:chrome_content_browser_client",
