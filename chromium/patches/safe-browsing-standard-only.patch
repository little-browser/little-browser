# Little Browser: Safe Browsing standard protection only, in the engine on every platform.
# - Enhanced protection and extended reporting are hard-disabled (pref/policy/sync cannot enable them).
# - No real-time hash-prefix lookups: the local hash-prefix database only.
# The settings that hide the Enhanced option and the extended-reporting toggle are each platform's
# view half: desktop/patches/lb/safe-browsing-standard-only-ui.patch and
# android/patches/safe-browsing-standard-only-settings.patch.

diff --git a/components/safe_browsing/core/common/features.cc b/components/safe_browsing/core/common/features.cc
index be66f22..ff8c6ff 100644
--- a/components/safe_browsing/core/common/features.cc
+++ b/components/safe_browsing/core/common/features.cc
@@ -363,9 +363,11 @@ BASE_FEATURE(kGooglePlayProtectReducesWarnings,
 BASE_FEATURE(kGoogleStandardDeviceBoundSessionCredentials,
              base::FEATURE_DISABLED_BY_DEFAULT);
 
+// Little Browser: look URLs up in the local hash-prefix database only;
+// no per-navigation real-time lookups (not even via the OHTTP relay).
 BASE_FEATURE(kHashPrefixRealTimeLookups,
              "SafeBrowsingHashPrefixRealTimeLookups",
-             base::FEATURE_ENABLED_BY_DEFAULT);
+             base::FEATURE_DISABLED_BY_DEFAULT);
 constexpr base::FeatureParam<std::string> kHashPrefixRealTimeLookupsRelayUrl{
     &kHashPrefixRealTimeLookups,
     "SafeBrowsingHashPrefixRealTimeLookupsRelayUrl",
@@ -390,7 +392,7 @@ constexpr base::FeatureParam<std::string>
 
 BASE_FEATURE(kHashPrefixRealTimeLookupsSamplePing,
              "SafeBrowsingHashPrefixRealTimeLookupsSamplePing",
-             base::FEATURE_ENABLED_BY_DEFAULT);
+             base::FEATURE_DISABLED_BY_DEFAULT);
 constexpr base::FeatureParam<int> kHashPrefixRealTimeLookupsSampleRate{
     &kHashPrefixRealTimeLookupsSamplePing,
     "HashPrefixRealTimeLookupsSampleRate", /*default_value=*/5};
