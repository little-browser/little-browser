         session_id, lb::kPinnedGroupSessionKey, lb_group));
+  }
+  // Little Browser: a tab's name and pinned link (chromium/lb), as tab extra data.
+  if (const std::string lb_tab = lb::GetTabCustomSessionData(tab); !lb_tab.empty()) {
+    command_storage_manager()->AppendRebuildCommand(sessions::CreateAddTabExtraDataCommand(
+        session_id, lb::kTabCustomSessionKey, lb_tab));
   }
 
   // Record the association between the sessionStorage namespace and the tab.
