# Little Browser: a tab can be renamed, and a pinned tab keeps a link, the page it goes back to
# (docs/ux.md §6). chromium/lb keeps both by the tab (lb/browser/ui/tabs/tab_custom_data.h); this
# hooks them in:
# - a named tab's row shows its name instead of the page's title, also while loading;
# - the tab menu has Rename Tab…, and for a pinned tab Edit Link… and Use Current Page as Link,
#   after Pin/Unpin; chromium/lb enables and runs them. Their command ids start
#   at 900, so the tab menu's command enum gets a fixed underlying type that makes them valid;
# - the name and the link are saved as tab extra data, also when Chromium rebuilds its session
#   file and in tab restore's record of a closed tab or window (a restored tab gets them back
#   through lb::OnTabRestored, pinned-groups.patch).
--- a/chrome/browser/sessions/session_service_base.cc
+++ b/chrome/browser/sessions/session_service_base.cc
@@ -5,6 +5,7 @@
 #include "chrome/browser/sessions/session_service_base.h"
 
 #include "lb/browser/ui/tabs/pinned_group_tracker.h"
+#include "lb/browser/ui/tabs/tab_custom_data.h"
 #include "lb/browser/ui/views/sidebar/sidebar_controller.h"
 
 #include <stddef.h>
@@ -682,6 +683,11 @@
