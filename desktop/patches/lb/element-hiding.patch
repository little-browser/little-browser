# Little Browser: element hiding (docs/design.md §5). Each frame gets desktop/lb's
# ElementHidingAgent, which asks the browser for the stylesheets that hide what is left of
# blocked ads; the browser answers through the frame's interface binders
# (desktop/lb/browser/adblock/element_hiding_host.h), also for a page being prerendered.
--- a/chrome/browser/chrome_browser_interface_binders.cc
+++ b/chrome/browser/chrome_browser_interface_binders.cc
@@ -3,6 +3,8 @@
 // found in the LICENSE file.
 
 #include "chrome/browser/chrome_browser_interface_binders.h"
+
+#include "lb/browser/adblock/element_hiding_host.h"
 
 #include <utility>
 
@@ -430,6 +432,8 @@
     mojo::BinderMapWithContext<content::RenderFrameHost*>* map,
     content::RenderFrameHost* render_frame_host) {
   map->Add<glic::mojom::WebClientHandler>(&glic::BindGlicWebClientHandler);
+  // Little Browser: element hiding asks for the stylesheets that hide ads' leftovers.
+  lb::AddElementHidingBinder(map);
   // Defense in depth: privileged capability interfaces are not even registered
   // for a frame outside a privileged process, so a non-PWC frame cannot
   // request them at all. The bind-time gate (pwc::EnforceCapabilityGate)
--- a/chrome/browser/chrome_content_browser_client_binder_policies.cc
+++ b/chrome/browser/chrome_content_browser_client_binder_policies.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/chrome_content_browser_client_binder_policies.h"
 
+#include "lb/browser/adblock/element_hiding_host.h"
+
 #include "chrome/browser/ui/webui/bluetooth_internals/bluetooth_internals.mojom.h"
 #include "components/autofill/content/common/mojom/autofill_driver.mojom.h"
 #include "components/page_load_metrics/common/page_load_metrics.mojom.h"
@@ -65,4 +67,6 @@
     content::MojoBinderPolicyMap& policy_map) {
   RegisterPoliciesForNonAssociatedInterfaces(policy_map);
   RegisterPoliciesForChannelAssociatedInterfaces(policy_map);
+  // Little Browser: element hiding, so a prerendered page is ready when shown.
+  lb::AddElementHidingPrerenderPolicy(policy_map);
 }
--- a/chrome/renderer/BUILD.gn
+++ b/chrome/renderer/BUILD.gn
@@ -128,6 +128,7 @@
 
   deps = [
     ":process_state",
+    "//lb:renderer",  # Little Browser: element hiding in each frame
     "//base/allocator:buildflags",
     "//build:chromeos_buildflags",
     "//chrome:resources",
--- a/chrome/renderer/chrome_content_renderer_client.cc
+++ b/chrome/renderer/chrome_content_renderer_client.cc
@@ -3,6 +3,8 @@
 // found in the LICENSE file.
 
 #include "chrome/renderer/chrome_content_renderer_client.h"
+
+#include "lb/renderer/element_hiding_agent.h"
 
 #include <functional>
 #include <memory>
@@ -656,6 +658,8 @@
   service_manager::BinderRegistry* registry = render_frame_observer->registry();
 
   new prerender::NoStatePrefetchRenderFrameObserver(render_frame);
+  // Little Browser: element hiding (it deletes itself with the frame).
