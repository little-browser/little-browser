# Little Browser: extensions update from the Chrome Web Store, without usage pings and without
# hardware fields (docs/design.md section 5 lists what an update check carries).
# - Update checks: ungoogled's block-requests.patch stops every update_client check (and never
#   answers it). Checks for extensions (product id CRX) go ahead again; the component updater's
#   stay blocked.
# - No pings. ChromeUpdateClientConfig has no ping URL, so no install, update or uninstall events
#   are sent, and update_checker.cc sends no install id and no ping (roll-call and active days).
#   Extensions that ExtensionDownloader updates send no pings either: their ping domain is
#   domain-substituted, so it never matches a real update server.
# - No hardware fields. protocol_serializer_json.cc leaves out the memory size and CPU features
#   upstream adds to every update_client request.
--- a/chrome/browser/extensions/updater/chrome_update_client_config.cc
+++ b/chrome/browser/extensions/updater/chrome_update_client_config.cc
@@ -229,10 +229,9 @@
 
 std::vector<GURL> ChromeUpdateClientConfig::PingUrl() const {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
-  if (url_override_.has_value()) {
-    return {*url_override_};
-  }
-  return impl_.PingUrl();
+  // Little Browser: no pings for extensions. No install, update or uninstall events are sent, and
+  // update checks carry no usage data (components/update_client/update_checker.cc).
+  return {};
 }
 
