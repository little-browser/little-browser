+bool VerticalTabStripRegionView::LbKeepsOutForPopup() {
+  const bool keep =
+      is_expanded_on_hover_ &&
+      lb::KeepsSidebarOutForPopup(
+          this, state_controller_->IsCollapsed() &&
+                    state_controller_->IsExpandOnHoverEnabled());
+  // Looks again until the popup closes: the pointer may be away by then. Each
+  // look asks first, so the timer stops once nothing keeps the sidebar out,
+  // also when it is shown meanwhile (UpdateExpandOnHoverState doesn't ask then).
+  if (keep && !lb_popup_timer_.IsRunning()) {
+    lb_popup_timer_.Start(
+        FROM_HERE, base::Milliseconds(250),
+        base::BindRepeating(
+            [](VerticalTabStripRegionView* view) {
+              view->LbKeepsOutForPopup();
+              view->UpdateExpandOnHoverState();
+            },
+            base::Unretained(this)));
+  } else if (!keep) {
+    lb_popup_timer_.Stop();
+  }
+  return keep;
+}
