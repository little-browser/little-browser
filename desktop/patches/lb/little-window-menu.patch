# Little Browser: the File menu has "New little window" (Cmd+Option+N) after "New Incognito
# window" (docs/ux.md section 8). The item comes from lb::AddLittleWindowMenuItem; the window
# enables it although Chromium's command table doesn't list IDC_NEW_LITTLE_WINDOW, and running it
# goes through lb::HandleCommandFirst (command-hooks.patch), as the shortcut does.
--- a/chrome/browser/ui/cocoa/main_menu_builder.mm
+++ b/chrome/browser/ui/cocoa/main_menu_builder.mm
@@ -29,6 +29,8 @@
 #import "ui/base/l10n/l10n_util_mac.h"
 #include "ui/strings/grit/ui_strings.h"
 
+#include "lb/browser/ui/views/little_window/little_window_menu.h"
+
 namespace chrome {
 namespace {
 
@@ -166,6 +168,11 @@
           .Build();
   // clang-format on
 
+  // Little Browser: "New little window" (lb/browser/ui/views/little_window/little_window_menu.h).
+  if (!is_pwa) {
+    lb::AddLittleWindowMenuItem(item.submenu);
+  }
+
   return item;
 }
 
