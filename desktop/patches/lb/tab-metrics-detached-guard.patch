# Little Browser: tabs of inactive spaces live detached from any window (chromium/lb sidebar);
# don't crash recording a metric for one.

diff --git a/chrome/browser/ui/tabs/tab_creation_metrics_controller.cc b/chrome/browser/ui/tabs/tab_creation_metrics_controller.cc
index 2339b1e..346f382 100644
--- a/chrome/browser/ui/tabs/tab_creation_metrics_controller.cc
+++ b/chrome/browser/ui/tabs/tab_creation_metrics_controller.cc
@@ -70,7 +70,8 @@ void TabCreationMetricsController::ScheduleRecordTabGroupingTransition() {
 
 void TabCreationMetricsController::RecordTabGroupingTransition(
     std::optional<tab_groups::TabGroupId> last_active_group_id) {
-  if (!tab_) {
+  // Little Browser: tabs of inactive spaces are detached from every window.
+  if (!tab_ || !tab_->GetBrowserWindowInterface()) {
     return;
   }
 
