# Little Browser: an "Ads" switch in the site-info panel's "Cookies and site data" view, under the
# third-party cookies switch, where people look when a site doesn't work. It is the built-in ad
# blocker's per-site setting (desktop/lb/browser/adblock/site_ads_row.*). PageInfo gains an
# accessor for its tab, which the switch reloads, and a way to drop its "reload this page" prompt,
# which that reload makes unnecessary.
--- a/components/page_info/page_info.h
+++ b/components/page_info/page_info.h
@@ -296,6 +296,13 @@
 
   const GURL& site_url() const { return site_url_; }
 
+  // Little Browser: the tab whose site this is (the ad blocker's switch reloads it).
+  content::WebContents* web_contents() const { return web_contents_.get(); }
+
+  // Little Browser: the page was reloaded, which applies every change made in the panel, so no
+  // "reload this page" prompt is needed when it closes.
+  void ForgetPendingReload() { show_info_bar_ = false; }
+
   // For most sites, this returns a human-friendly string based on site origin,
   // without scheme, the username and password, the path or trivial subdomains.
   //
--- a/chrome/browser/ui/views/page_info/page_info_cookies_content_view.cc
+++ b/chrome/browser/ui/views/page_info/page_info_cookies_content_view.cc
@@ -31,6 +31,7 @@
 #include "ui/views/metadata/view_factory.h"
 #include "ui/views/vector_icons.h"
 #include "ui/views/view_class_properties.h"
+#include "lb/browser/adblock/site_ads_row.h"
 
 #if BUILDFLAG(IS_CHROMEOS)
 #include "chrome/browser/ui/views/accessibility/non_accessible_image_view.h"
@@ -164,6 +165,11 @@
 
   AddThirdPartyCookiesContainer();
 
+  // Little Browser: the built-in ad blocker's per-site switch (desktop/lb/browser/adblock).
+  if (std::unique_ptr<views::View> ads = lb::MakeSiteAdsRow(presenter_)) {
+    AddChildView(std::move(ads));
+  }
+
 #if BUILDFLAG(IS_CHROMEOS)
   MaybeAddSyncDisclaimer();
 #endif
