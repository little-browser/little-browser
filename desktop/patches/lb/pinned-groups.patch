 bool TabStripModel::IsTabCollapsed(int index) const {
+  // Little Browser: a tab in a collapsed pinned group (chromium/lb) is collapsed too, so Ctrl+Tab
+  // and the choice of the next tab skip it as they do a collapsed group's tabs.
+  if (ContainsIndex(index) && lb::IsInCollapsedPinnedGroup(GetTabAtIndex(index))) {
+    return true;
+  }
   std::optional<tab_groups::TabGroupId> group = GetTabGroupForTab(index);
   return group.has_value() && IsGroupCollapsed(group.value());
 }
