# Little Browser: a pinned tab the user closes (Cmd+W, its close button, the tab menu, a middle
# click) goes to sleep instead of closing: it keeps its place, its page unloads, and clicking it
# loads the page again. A sleeping pinned tab looks faded, and its close button becomes "−", which
# removes it. The decision and the sleep live in lb/browser/ui/tabs/pinned_tab_sleep.cc; here
# every close passes through it, a tab replaced in a split view really closes, the tab row draws
# the sleeping look, and a discarded tab drops the old page's media, capture and device alerts.
# The second click of a double click on "✕" lands on the "−" it has just become, and is ignored.
--- a/chrome/browser/ui/tabs/tab_strip_model.cc
+++ b/chrome/browser/ui/tabs/tab_strip_model.cc
@@ -118,6 +118,7 @@
 #include "ui/base/models/list_selection_model.h"
 #include "ui/base/page_transition_types.h"
 #include "ui/gfx/range/range.h"
+#include "lb/browser/ui/tabs/pinned_tab_sleep.h"  // Little Browser
 
 using base::UserMetricsAction;
 using content::WebContents;
@@ -4021,7 +4022,9 @@
   std::vector<content::WebContents*> filtered_items;
   for (content::WebContents* contents : items) {
     tabs::TabInterface* tab = GetTabForWebContents(contents);
-    if (IsTabClosable(tab)) {
+    // Little Browser: a pinned tab the user closes goes to sleep instead (lb/browser/ui/tabs).
+    if (IsTabClosable(tab) &&
+        !(tab && lb::SleepInsteadOfClose(*this, *tab, close_types))) {
       filtered_items.push_back(contents);
     } else {
       for (auto& observer : observers_) {
@@ -4703,7 +4706,9 @@
     const int split_index = GetIndexOfTab(split_tab);
     MoveTabToIndexImpl(update_index, split_index, split_tab->GetGroup(),
                        split_tab->IsPinned(), initial_split_active);
-    CloseTabs({split_tab->GetContents()}, TabCloseTypes::CLOSE_USER_GESTURE);
+    // Little Browser: the replaced tab really closes; a user-gesture close of a pinned tab would
+    // only put it to sleep (lb/browser/ui/tabs/pinned_tab_sleep.h).
+    CloseTabs({split_tab->GetContents()}, TabCloseTypes::CLOSE_NONE);
   } else {
     tabs::TabInterface* update_tab = GetTabAtIndex(update_index);
     std::optional<tab_groups::TabGroupId> initial_split_group =
--- a/chrome/browser/ui/tabs/alert/tab_alert_controller.cc
+++ b/chrome/browser/ui/tabs/alert/tab_alert_controller.cc
@@ -352,7 +352,20 @@
             base::BindRepeating(
                 &TabAlertController::OnRecentlyAudibleStateChanged,
                 base::Unretained(this)));
+    // Little Browser: take the audio state from the new contents (see below).
+    OnRecentlyAudibleStateChanged(audible_helper->WasRecentlyAudible());
   }
+  // Little Browser: a discarded tab's page is gone (a pinned tab put to sleep while in use,
+  // lb/browser/ui/tabs/pinned_tab_sleep.h). The old contents' "stopped" events no longer reach
+  // this controller, which observes the new contents now, so clear what only a live page does.
+  ScopedAlertNotifier notifier(this);
+  for (TabAlert alert :
+       {TabAlert::kPipPlaying, TabAlert::kMediaRecording, TabAlert::kVideoRecording,
+        TabAlert::kAudioRecording, TabAlert::kTabCapturing, TabAlert::kDesktopCapturing,
+        TabAlert::kBluetoothConnected, TabAlert::kBluetoothScanActive, TabAlert::kUsbConnected,
+        TabAlert::kHidConnected, TabAlert::kSerialConnected}) {
+    UpdateAlertState(alert, false);
+  }
 }
 
