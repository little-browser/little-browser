+bool VerticalTabStripRegionView::LbPointerNearEdge() const {
+  if (lb_pointer_near_edge_for_testing_) {
+    return *lb_pointer_near_edge_for_testing_;
+  }
+  // Only for the active window: outside it is where other apps get clicked,
+  // and Chromium's velocity timer doesn't check the window is active.
+  const views::Widget* widget = GetWidget();
+  if (!widget || !widget->ShouldPaintAsActive()) {
+    return false;
+  }
+  const gfx::Rect window = widget->GetWindowBoundsInScreen();
+  display::Screen* screen = display::Screen::Get();
+  return lb::InSidebarOutsideZone(screen->GetCursorScreenPoint(), window,
+                                  screen->GetDisplayMatching(window).bounds());
+}
+
+void VerticalTabStripRegionView::LbUpdateResizeArea(bool collapsed) {
+  const lb::SidebarResizeArea area = lb::SidebarResizeAreaFor(
+      collapsed, state_controller_->IsExpandOnHoverEnabled(),
+      is_expanded_on_hover_, resize_area_->is_resizing());
+  resize_area_->SetVisible(area.visible);
+  resize_area_width_ = area.wide ? kResizeAreaWidth : kCollapsedResizeAreaWidth;
 }
 
