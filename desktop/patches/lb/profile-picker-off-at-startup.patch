# Little Browser: no profile picker at launch by default. Spaces span profiles, so a launch
# restores the spaces; the picker's "Show on startup" box still turns it back on.
diff --git a/chrome/browser/profiles/profiles_state.cc b/chrome/browser/profiles/profiles_state.cc
index d1fcd93..66ddd1c 100644
--- a/chrome/browser/profiles/profiles_state.cc
+++ b/chrome/browser/profiles/profiles_state.cc
@@ -83,8 +83,10 @@ void RegisterPrefs(PrefRegistrySimple* registry) {
   registry->RegisterBooleanPref(prefs::kBrowserGuestModeEnforced, false);
   registry->RegisterBooleanPref(prefs::kBrowserAddPersonEnabled, true);
   registry->RegisterBooleanPref(prefs::kForceBrowserSignin, false);
+  // Little Browser: off by default. Spaces span profiles, so launching restores the spaces
+  // rather than asking which profile to open.
   registry->RegisterBooleanPref(prefs::kBrowserShowProfilePickerOnStartup,
-                                true);
+                                false);
   registry->RegisterIntegerPref(
       prefs::kBrowserProfilePickerAvailabilityOnStartup,
       static_cast<int>(ProfilePicker::AvailabilityOnStartup::kEnabled));
