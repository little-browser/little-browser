# Little Browser: in the vertical strip a tab can be dragged between the pinned and the unpinned
# area, live, the way it moves into and out of a tab group. The pointer picks the area (above the
# middle of the "+ New Tab" row is pinned), and entering the other area pins or unpins the dragged
# tabs; split views move whole. A drag that includes a tab group stays among the unpinned tabs while
# it lasts, since Chromium can't group pinned tabs; dropped above the row, desktop/lb makes it a
# pinned group (pinned-groups.patch). Upstream rebuilds a tab's view when its pin state changes,
# which would free the views the drag holds, so a dragged tab keeps its view instead. Cancelling the
# drag restores the original pin state; tabs dragged on into another window keep the state they have
# when they leave.
--- a/chrome/browser/ui/tabs/tab_strip_model.h
+++ b/chrome/browser/ui/tabs/tab_strip_model.h
@@ -512,6 +512,12 @@
   // been moved to maintain contiguity of pinned tabs at the beginning of the
   // tabstrip).)
   int SetTabPinned(int index, bool pinned);
+
+  // Little Browser: pins or unpins the tabs at `indices` (ascending), keeping split views whole.
+  // A tab drag across the vertical strip's pinned area uses it.
+  void LbSetTabsPinned(const std::vector<int>& indices, bool pinned) {
+    SetTabsPinned(indices, pinned);
+  }
 
   // Returns true if the tab at `index` is pinned.
   // See description above class for details on pinned tabs.
