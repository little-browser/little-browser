# Little Browser: session restore adds the selected tab first, then the others at their saved
# places. The first tab added to an empty window becomes active for a moment, and on macOS that
# shows and loads it, so a sleeping pinned tab at the top woke on every restart although another
# tab was selected (docs/ux.md §6). The order is lb::TabRestoreOrder (lb/browser/tabs/restore_order.h).
--- a/chrome/browser/sessions/session_restore.cc
+++ b/chrome/browser/sessions/session_restore.cc
@@ -4,6 +4,7 @@
 
 #include "chrome/browser/sessions/session_restore.h"
 
+#include "lb/browser/tabs/restore_order.h"
 #include "lb/browser/ui/views/sidebar/sidebar_controller.h"
 
 #include <stddef.h>
@@ -1095,7 +1096,13 @@
     // base::Time) can be mapped onto the TimeTicks timeline WebContents wants.
     const base::Time now = base::Time::Now();
     const base::TimeTicks now_ticks = base::TimeTicks::Now();
-    for (int i = 0; i < static_cast<int>(window.tabs.size()); ++i) {
+    // Little Browser: the selected tab is added first. The first tab added to an empty window
+    // becomes active for a moment, and on macOS that shows and loads it: a sleeping pinned tab
+    // first in the window would wake although another tab is selected.
+    for (int i : lb::TabRestoreOrder(
+             static_cast<int>(window.tabs.size()),
+             initial_tab_count == 0 ? std::optional<int>(selected_tab_index)
+                                    : std::nullopt)) {
       const sessions::SessionTab& tab = *(window.tabs[i]);
 
       // Loads are scheduled for each restored tab unless the tab is going to
