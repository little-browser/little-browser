# Little Browser: with "Warn Before Quitting" on, every user quit asks — ⌘Q, the menu, the Dock and
# AppleScript — with a "Quit Little Browser?" dialog (Quit / Cancel / Quit and Don't Ask Again)
# instead of Chromium's hold-⌘Q panel. Exits that are already decided never ask: a ⌘Q quit just
# confirmed, restarts, chrome://quit, DevTools and signals (BrowserProcessPlatformPart::AttemptExit
# sets a flag around the final -terminate:), plus logout and shutdown of the Mac.

--- a/chrome/browser/app_controller_mac.h
+++ b/chrome/browser/app_controller_mac.h
@@ -91,6 +91,10 @@
 
 // Run the quit confirmation panel if conditions are met and return the result.
 - (ConfirmQuitResult)confirmQuitIfNeeded;
+
+// Little Browser: set while an exit that needs no question runs (see
+// BrowserProcessPlatformPart::AttemptExit); -confirmQuitIfNeeded doesn't ask then.
+@property(nonatomic) BOOL lbQuitAlreadyDecided;
 
 // Indicate that the system is powering off or logging out.
 - (void)willPowerOff:(NSNotification*)inNotification;
