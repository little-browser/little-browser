-                }];
+// Little Browser: "Quit Little Browser?" with Quit, Cancel and "Quit and Don't Ask Again"
+// (which turns off Warn Before Quitting).
+- (ConfirmQuitResult)lbConfirmQuitWithDialog {
+  // Already asking (e.g. ⌘Q pressed again, or held, while the dialog is up).
+  if (_lbQuitDialogShowing) {
+    return ConfirmQuitResultAborted;
+  }
+  base::AutoReset<BOOL> showing(&_lbQuitDialogShowing, YES);
+  NSString* product = l10n_util::GetNSString(IDS_PRODUCT_NAME);
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.messageText = [NSString stringWithFormat:@"Quit %@?", product];
+  alert.informativeText = [NSString
+      stringWithFormat:@"You can turn this off with %@ › Warn Before Quitting.", product];
+  [alert addButtonWithTitle:@"Quit"];
+  NSButton* cancel = [alert addButtonWithTitle:@"Cancel"];
+  cancel.keyEquivalent = @"\e";
+  [alert addButtonWithTitle:@"Quit and Don't Ask Again"];
 
-  return quitConfirmed ? ConfirmQuitResultConfirmed : ConfirmQuitResultAborted;
+  [NSApp activateIgnoringOtherApps:YES];
+  const NSModalResponse response = [alert runModal];
+  if (response == NSAlertSecondButtonReturn) {
+    return ConfirmQuitResultAborted;
+  }
+  if (response == NSAlertThirdButtonReturn) {
+    g_browser_process->local_state()->SetBoolean(prefs::kConfirmToQuitEnabled, false);
+  }
+  return ConfirmQuitResultConfirmed;
 }
 
