+  BOOL _lbQuitDialogShowing;
 
   // This will be true after receiving a |-applicationWillTerminate:| event.
   BOOL _isShuttingDown;
@@ -1020,30 +1023,48 @@
     return ConfirmQuitResultNotPrompted;
