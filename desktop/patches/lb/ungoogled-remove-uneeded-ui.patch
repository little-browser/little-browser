+++ b/media/base/media_switches.cc
@@ -727,7 +727,7 @@
 );
 
 // Enables the Live Caption feature on supported devices.
-BASE_FEATURE(kLiveCaption, base::FEATURE_ENABLED_BY_DEFAULT);
