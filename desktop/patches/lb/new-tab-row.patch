+  // Little Browser: see SetLbNewTabRow().
+  raw_ptr<views::View> lb_new_tab_row_ = nullptr;
   bool is_collapsed_ = false;
 
   // Used for seek time metrics from the time the mouse enters the tabstrip.
--- a/chrome/browser/ui/views/tabs/common/tab_strip_view.cc
+++ b/chrome/browser/ui/views/tabs/common/tab_strip_view.cc
@@ -461,6 +461,14 @@
   PrefService* prefs = GetPrefs();
