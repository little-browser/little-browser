+
+void TabStripView::SetLbNewTabRow(std::unique_ptr<views::View> row) {
+  if (lb_new_tab_row_) {
+    RemoveChildViewT(lb_new_tab_row_.ExtractAsDangling());
+  }
+  lb_new_tab_row_ = AddChildView(std::move(row));
+  InvalidateLayout();
 }
 
