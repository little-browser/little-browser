+  // Little Browser: a row between the pinned and the unpinned tabs ("+ New Tab", from
+  // chromium/lb), laid out in the vertical orientation only. Replaces any earlier row.
+  void SetLbNewTabRow(std::unique_ptr<views::View> row);
+  views::View* lb_new_tab_row() const { return lb_new_tab_row_; }
+
   PinnedTabContainerView* GetPinnedTabsContainer() const;
   UnpinnedTabContainerView* GetUnpinnedTabsContainer() const;
   TabScrollButtonContainer* GetScrollButtonContainer() const;
@@ -150,6 +155,8 @@
   raw_ptr<views::ScrollView> unpinned_tabs_scroll_view_ = nullptr;
