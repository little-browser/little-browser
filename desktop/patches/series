# Little Browser patches, applied after ungoogled-chromium's core and platform patches, in this order.
# One concern per patch. Format: <path relative to desktop/patches>   # one-line reason
lb/safe-browsing-standard-only.patch  # standard protection only, local hash-prefix DB, no reporting
lb/macos-no-ai-sandbox-params.patch   # macOS: non-Safe-Browsing half of an ungoogled patch we skip
lb/settings-product-icon.patch        # branding: Little Browser mark as the WebUI product icon
lb/vertical-tabs-default.patch        # sidebar layout (vertical tabs) by default
lb/sidebar-hooks.patch                # host desktop/lb's sidebar (header, footer, "+ New Tab") in the vertical tab strip
lb/new-tab-row.patch                  # a slot between pinned and today's tabs for "+ New Tab"
lb/sidebar-prefs.patch                # register the sidebar's prefs (active space per profile, spaces browser-wide)
lb/command-hooks.patch                # Cmd+T / Cmd+L → command bar
lb/tab-metrics-detached-guard.patch   # don't crash on tabs of inactive spaces (detached)
lb/session-spaces.patch               # restored windows return to their space
lb/continue-session-default.patch     # "continue where you left off" by default (spaces keep tabs)
lb/confirm-every-quit.patch           # every quit asks while "Warn Before Quitting" is on
lb/profile-picker-off-at-startup.patch # launches restore spaces, not the profile picker
lb/welcome-page-url.patch             # first-run page at chrome://welcome/
lb/first-run-profile-name.patch       # first run doesn't name the profile "Work"
lb/mac-data-folder.patch              # macOS data in Application Support/Little Browser
lb/contents-card.patch                # with vertical tabs, the page is an inset rounded card
lb/pinned-list.patch                  # pinned tabs are list rows, not icon tiles (tiles only when collapsed)
lb/no-saved-groups-button.patch      # no saved tab groups button in the vertical strip header
lb/no-tab-detach.patch               # tabs can not be dragged out into a new window
lb/drag-pins.patch                   # drag tabs between the pinned and the unpinned area
lb/pinned-tab-sleep.patch            # closing a pinned tab puts it to sleep, it stays in place
lb/one-group-close.patch             # a tab group's menu has one Close, no Delete
lb/no-app-menu-tab-groups.patch      # no Tab groups (saved tab groups) menu in the app menu
lb/tab-click-hook.patch              # a click on a tab row reaches desktop/lb (New Tab Group placeholder)
