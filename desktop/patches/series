# Little Browser desktop patches, applied after ungoogled-chromium's core and platform patches and
# after the engine patches every Chromium platform shares (chromium/patches/series), in this order.
# One concern per patch. Format: <path relative to desktop/patches>   # one-line reason
# A reason that starts with a platform tag, as in "# [mac] …", is for that platform only (one of
# desktop/platforms/). A patch never mixes engine and view code; desktop/patches/README.md has the
# rules, which chromium/scripts/check_series.py checks.
lb/ungoogled-remove-uneeded-ui.patch # ungoogled's remove-uneeded-ui.patch, rebased onto our tree (we skip the patch it builds on)
lb/ungoogled-remove-uneeded-ui-ui.patch # ungoogled's remove-uneeded-ui.patch, rebased onto our tree (we skip the patch it builds on) (UI)
lb/safe-browsing-standard-only-ui.patch # standard protection only, local hash-prefix DB, no reporting (UI)
lb/macos-no-ai-sandbox-params.patch   # [mac] non-Safe-Browsing half of an ungoogled patch we skip
lb/settings-product-icon.patch        # branding: Little Browser mark as the WebUI product icon
lb/release-version-ui.patch           # About and chrome://version show the release, <Chromium version>-<revision> (UI)
lb/vertical-tabs-default.patch        # sidebar layout (vertical tabs) by default
lb/sidebar-hooks.patch                # host chromium/lb's sidebar (header, footer, "+ New Tab") in the vertical tab strip
lb/new-tab-row.patch                  # a slot between pinned and today's tabs for "+ New Tab"
lb/command-hooks.patch                # Cmd+T / Cmd+L → command bar
lb/tab-metrics-detached-guard.patch   # don't crash on tabs of inactive spaces (detached)
lb/session-spaces.patch               # restored windows return to their space
lb/continue-session-default.patch     # "continue where you left off" by default (spaces keep tabs)
lb/confirm-every-quit.patch           # [mac] every quit asks while "Warn Before Quitting" is on
lb/profile-picker-off-at-startup.patch # launches restore spaces, not the profile picker
lb/welcome-page-url.patch             # first-run page at chrome://welcome/
lb/welcome-page-url-ui.patch          # first-run page at chrome://welcome/ (UI)
lb/first-run-profile-name.patch       # first run doesn't name the profile "Work"
lb/mac-data-folder.patch              # [mac] macOS data in Application Support/Little Browser
lb/contents-card.patch                # with vertical tabs, the page is an inset rounded card
lb/pinned-list.patch                  # pinned tabs are list rows, not icon tiles (tiles only when collapsed)
lb/no-saved-groups-button.patch      # no saved tab groups button in the vertical strip header
lb/no-tab-detach.patch               # tabs can not be dragged out into a new window
lb/drag-pins.patch                   # drag tabs between the pinned and the unpinned area
lb/drag-pins-ui.patch                 # drag tabs between the pinned and the unpinned area (UI)
lb/pinned-tab-sleep.patch            # closing a pinned tab puts it to sleep, it stays in place
lb/pinned-tab-sleep-ui.patch          # closing a pinned tab puts it to sleep, it stays in place (UI)
lb/one-group-close.patch             # a tab group's menu has one Close, no Delete
lb/no-reopen-closed.patch            # no Reopen Closed Tab/Group/Window, no Cmd+Shift+T, no Recently Closed
lb/no-reopen-closed-ui.patch          # no Reopen Closed Tab/Group/Window, no Cmd+Shift+T, no Recently Closed (UI)
lb/no-reopen-closed-mac.patch         # [mac] no Reopen Closed Tab/Group/Window, no Cmd+Shift+T, no Recently Closed (Cocoa)
lb/no-app-menu-tab-groups.patch      # no Tab groups (saved tab groups) menu in the app menu
lb/tab-click-hook.patch              # a click on a tab row reaches chromium/lb (New Tab Group placeholder)
lb/no-restore-background-load.patch  # a restored session loads only the shown tab; sleeping pinned tabs stay asleep
lb/restore-selected-first.patch      # a restored window adds its selected tab first, so no other tab wakes
lb/web-store-install.patch           # "Add to Chrome" on the Chrome Web Store downloads and installs the extension
lb/extension-updates.patch           # extensions update from the Chrome Web Store, with no usage pings or hardware fields
lb/web-store-links.patch             # links to the Chrome Web Store in the app menu and on chrome://extensions
lb/web-store-links-ui.patch           # links to the Chrome Web Store in the app menu and on chrome://extensions (UI)
lb/web-store-no-referrer-chain.patch # the Chrome Web Store page gets no referrer chain (the pages that led to it)
lb/ad-blocking-page-info-ui.patch     # an Ads switch in the site-info panel's "Cookies and site data", under third-party cookies (UI)
lb/no-cookie-controls-icon.patch     # no third-party cookies eye icon; its switch is in the site-info panel
lb/peek-hooks.patch                  # Shift+click opens a link in Peek, a card over the page
lb/little-window-toolbar.patch       # a little window's toolbar row has Copy URL and Open in <space>
lb/little-window-shortcut.patch       # [mac] Cmd+Option+N opens the command bar for a new little window
lb/little-window-link-menu.patch     # a link's context menu has Open Link in Little Window
lb/little-window-menu.patch           # [mac] the File menu has New little window (Cmd+Option+N)
lb/little-window-other-apps.patch    # links on a second launch's command line open in little windows
lb/little-window-other-apps-mac.patch # [mac] links other apps open through macOS (mail, `open`) open in little windows
lb/updater.patch                      # [mac] start the updater (Sparkle) when the app is packaged with it
lb/import-settings-row.patch         # Settings' import route opens our import dialog
lb/pinned-groups.patch             # tab groups among the pinned tabs (ours: Chromium cannot group pinned tabs)
lb/pinned-groups-ui.patch             # tab groups among the pinned tabs (ours: Chromium cannot group pinned tabs) (UI)
lb/tab-search-always.patch           # tab search can't be unpinned: no Pin/Unpin in its menus or Settings
lb/tab-search-always-ui.patch         # tab search can't be unpinned: no Pin/Unpin in its menus or Settings (UI)
lb/keychain-name.patch                # [mac] our own keychain item (Little Browser Safe Storage), keeping an existing install's password
lb/space-avatar.patch                # the profile button and profile menu show the window's space emoji
lb/no-lens-chip.patch                 # no Google Lens promo chip in the address bar (it crashed on parked tabs)
lb/help-url.patch                     # Help opens our site, not Google's support pages (blocked here)
lb/tab-names.patch                   # a tab can be renamed; a pinned tab keeps a link to go back to
lb/tab-names-ui.patch                # a renamed tab is read by its name (accessible label)
lb/hidden-sidebar-ui.patch            # a hidden sidebar keeps only an edge band and slides in, full height and resizable, over the page
lb/sidebar-max-width.patch            # the sidebar opens at, and narrows to, 312 px, room for its row of buttons; up to 600 px wide
lb/load-progress-ui.patch             # a thin line at the top of the page shows its load, in every window
lb/sidebar-toolbar-ui.patch           # the toolbar is at the top of the sidebar; nothing above the page (UI)
lb/little-window-title-row.patch     # [mac] a little window's address shares the window buttons' row: no title bar above it
