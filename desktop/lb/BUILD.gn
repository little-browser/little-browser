import("//testing/test.gni")

# Little Browser logic that doesn't need views or a browser window: unit tested by
# lb_unittests. The sidebar's views target depends on it (patches/lb/sidebar-hooks.patch), which
# is also what makes GN load this file.
source_set("model") {
  sources = [
    "browser/command_bar/command_matching.cc",
    "browser/command_bar/command_matching.h",
    "browser/spaces/space_model.cc",
    "browser/spaces/space_model.h",
    "browser/spaces/swipe_tracker.cc",
    "browser/spaces/swipe_tracker.h",
    "browser/tabs/tab_to_show.cc",
    "browser/tabs/tab_to_show.h",
  ]
  public_deps = [ "//components/tab_groups" ]
  deps = [
    "//base",
    "//net",
    "//url",
  ]
}

# desktop/lb/AGENTS.md says how to build and run these.
test("lb_unittests") {
  sources = [
    "browser/command_bar/command_matching_unittest.cc",
    "browser/spaces/space_model_unittest.cc",
    "browser/spaces/swipe_tracker_unittest.cc",
    "browser/tabs/tab_to_show_unittest.cc",
  ]
  deps = [
    ":model",
    "//base",
    "//base/test:run_all_unittests",
    "//net",
    "//testing/gtest",
    "//url",
  ]
}
