# lb_unittests. The sidebar's views target depends on it (patches/lb/sidebar-hooks.patch), which
# is also what makes GN load this file.
source_set("model") {
  sources = [
    "browser/adblock/filter_lists.cc",
    "browser/adblock/filter_lists.h",
    "browser/adblock/site_ads.cc",
    "browser/adblock/site_ads.h",
    "browser/command_bar/command_matching.cc",
    "browser/command_bar/command_matching.h",
    "browser/first_run/first_run_questions.cc",
    "browser/first_run/first_run_questions.h",
    "browser/importer/imported_tabs.cc",
    "browser/importer/imported_tabs.h",
    "browser/importer/chromium_profile_reader.cc",
    "browser/importer/chromium_profile_reader.h",
    "browser/importer/cookie_decryptor.cc",
    "browser/importer/cookie_decryptor.h",
    "browser/importer/import_choices.cc",
    "browser/importer/import_choices.h",
    "browser/importer/import_text.cc",
    "browser/importer/import_text.h",
    "browser/importer/imported_bookmarks.cc",
    "browser/importer/imported_bookmarks.h",
    "browser/little_window/little_window_rules.cc",
    "browser/little_window/little_window_rules.h",
    "browser/password/password_manager_choice.cc",
    "browser/password/password_manager_choice.h",
    "browser/peek/peek_rules.cc",
    "browser/peek/peek_rules.h",
    "browser/prefs/pref_defaults.cc",
    "browser/prefs/pref_defaults.h",
    "browser/privacy/tracking_params.cc",
    "browser/privacy/tracking_params.h",
    "browser/spaces/space_model.cc",
    "browser/spaces/space_model.h",
    "browser/spaces/swipe_tracker.cc",
    "browser/spaces/swipe_tracker.h",
    "browser/tabs/pinned_close.cc",
    "browser/tabs/pinned_close.h",
    "browser/tabs/pinned_groups.cc",
    "browser/tabs/pinned_groups.h",
    "browser/tabs/restore_order.cc",
    "browser/tabs/restore_order.h",
    "browser/tabs/tab_names.cc",
    "browser/tabs/tab_names.h",
    "browser/tabs/tab_to_show.cc",
    "browser/tabs/tab_to_show.h",
    "browser/ui/lb_command_ids.h",  # also in the sidebar's views target, which includes it
    "browser/update/update_reminder.cc",
    "browser/update/update_reminder.h",
  ]
  public_deps = [
    ":core_bridge",  # import: lb-core's types in the readers' results
    "//services/network/public/cpp",  # tracking parameters: the navigation's request
    "//third_party/blink/public/common",  # tracking parameters: the loader throttle
    "//components/security_state/core",  # Peek: the site label's warning
    "//components/tab_groups",
    "//components/user_data_importer/common",  # import: Chromium importers' bookmark entries
    "//ui/base:types",
    "//ui/gfx/geometry",
  ]
  deps = [
    "//base",
    "//chrome/app:command_ids",  # Peek: which browser commands act on the Peek's page
    "//components/autofill/core/common",  # pref defaults: address autofill
    "//components/pref_registry",
    "//components/subresource_filter/core/common",
    "//components/subresource_filter/tools/rule_parser",
    "//components/url_formatter",
    "//components/url_pattern_index",
    "//net",
    "//sql",  # import: reading copies of other browsers' databases
    "//base:i18n",  # import: numbers in the summary
    "//components/sessions",  # import: open tabs from a session file
    "//crypto",  # import: cookie decryption
    "//third_party/boringssl",  # import: cookie key (PBKDF2)
    "//third_party/protobuf:protobuf_lite",
    "//url",
  ]
}

if (is_mac) {
  # Little Browser's own Safe Storage keychain item, and when an existing install keeps the
  # password from Chromium's item (browser/keychain/keychain_key.h). Chromium's os_crypt and
  # chrome/app depend on it (patches/lb/keychain-name.patch), so it depends on //base only.
  source_set("keychain") {
    sources = [
      "browser/keychain/keychain_key.cc",
      "browser/keychain/keychain_key.h",
    ]
    deps = [ "//base" ]
  }

  # The updater: loads Sparkle when the app is packaged with it (browser/update/updater_mac.h).
  # chrome/browser's macOS code depends on it (patches/lb/updater.patch).
  source_set("updater") {
    sources = [
      "browser/update/sparkle_api.h",
      "browser/update/updater_mac.h",
      "browser/update/updater_mac.mm",
    ]
    deps = [
      ":model",
      "//base",
    ]
    frameworks = [ "Foundation.framework" ]
  }
}

