import("//build/rust/rust_static_library.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//testing/test.gni")

# lb-core, the shared Rust core (core/lb-core; fetch.sh links it at //lb_core), built with
# Chromium's toolchain and vendored crates (docs/design.md §4.4). Its tests run as
# lb_core_unittests. Keep `sources` the crate's files (../scripts/check_lb_tests.py checks it).
rust_static_library("lb_core") {
  crate_name = "lb_core"
  crate_root = "//lb_core/src/lib.rs"
  edition = "2021"
  sources = [
    "//lb_core/src/adblock.rs",
    "//lb_core/src/command_bar.rs",
    "//lb_core/src/element_hiding.rs",
    "//lb_core/src/import/addresses.rs",
    "//lb_core/src/import/arc.rs",
    "//lb_core/src/import/bookmarks.rs",
    "//lb_core/src/import/cookies.rs",
    "//lb_core/src/import/extensions.rs",
    "//lb_core/src/import/history.rs",
    "//lb_core/src/import/mod.rs",
    "//lb_core/src/import/plan.rs",
    "//lb_core/src/import/profiles.rs",
    "//lb_core/src/import/safari.rs",
    "//lb_core/src/import/search.rs",
    "//lb_core/src/import/sources.rs",
    "//lb_core/src/import/tabs.rs",
    "//lb_core/src/lib.rs",
    "//lb_core/src/model.rs",
    "//lb_core/src/search_choice.rs",
    "//lb_core/src/spaces.rs",
    "//lb_core/src/sync.rs",
    "//lb_core/src/tracking_params.rs",
  ]
  deps = [ "//third_party/rust/serde_json/v1:lib" ]
  build_native_rust_unit_tests = true
}

# The C++ binding of lb-core (namespace lb::core): include "lb/core_bridge/lib.rs.h" for import,
# "lb/core_bridge/rules.rs.h" for the browser rules (spaces, command bar, filter lists, search choice).
rust_static_library("core_bridge") {
  crate_name = "lb_core_bridge"
  crate_root = "core_bridge/lib.rs"
  edition = "2021"
  allow_unsafe = true  # cxx's generated glue
  sources = [
    "core_bridge/lib.rs",
    "core_bridge/rules.rs",
  ]
  cxx_bindings = [
    "core_bridge/lib.rs",
    "core_bridge/rules.rs",
  ]
  deps = [ ":lb_core" ]
}

# Element hiding between a page and the browser (common/element_hiding.mojom).
mojom("mojom") {
  sources = [ "common/element_hiding.mojom" ]
  public_deps = [ "//url/mojom:url_mojom_gurl" ]
}

# The class and id names a page sends for element hiding's generic rules, and what the browser
# accepts: used by //lb:renderer and the browser side (unit tested; ../scripts/check_lb_tests.py
# checks it like //lb:model).
source_set("page_names") {
  sources = [
    "common/page_names.cc",
    "common/page_names.h",
  ]
  deps = [ "//base" ]
}

# Our renderer-side code: element hiding in each frame. chrome/renderer depends on it and creates
# the agent for each frame (patches/lb/element-hiding.patch).
source_set("renderer") {
  sources = [
    "renderer/element_hiding_agent.cc",
    "renderer/element_hiding_agent.h",
  ]
  deps = [
    ":mojom",
    ":page_names",
    "//base",
    "//content/public/renderer",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public:blink",
    "//url",
  ]
}

